#include <dt-bindings/phy/phy.h>
/ {
	chosen {
		bootargs = " earlycon console=ttyPS0,115200 clk_ignore_unused root=/dev/ram0 rw net.ifnames=0 biosdevname=0 cma=128M";
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

        cma_reserved: cma@0 {
            compatible = "shared-dma-pool";
            reusable;
            reg = <0x30000000 0x08000000>; /* 128 MB at 768 MB */
            alignment = <0 0x1000>; /* 4 kB aligned */
            no-map;
        };
	};
};
